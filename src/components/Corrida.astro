---
import panelsData from "../data/panels.json";
import episodesRaw from "../data/episodes.json";
import { PANELISTS, base, formatDate, portrait, shortName } from "../lib/data";

/* ── As três formações ── */
const PANEL_RANGES: Record<string, { start: string; end: string | null }> = {
  original: { start: "2018-05-01", end: "2021-01-31" },
  transicao: { start: "2021-02-01", end: "2023-10-31" },
  atual: { start: "2024-03-01", end: null },
};

/** Período em que cada pessoa foi titular; acertos como convidado ficam de fora do "maior vencedor". */
const BENCH_RANGES: Record<string, { start: string; end: string | null }> = {
  "Fernando de Barros e Silva": { start: "2018-05-01", end: null },
  "Malu Gaspar": { start: "2018-05-01", end: "2021-01-31" },
  "José Roberto de Toledo": { start: "2018-05-01", end: "2023-10-31" },
  "Thais Bilenky": { start: "2021-02-01", end: "2023-10-31" },
  "Ana Clara Costa": { start: "2024-03-01", end: null },
  "Celso Rocha de Barros": { start: "2024-03-01", end: null },
};

const ms = (iso: string | null) => (iso ? new Date(iso).getTime() : Number.POSITIVE_INFINITY);

function panelStats(slug: string, members: string[]) {
  const range = PANEL_RANGES[slug];
  const eps = episodesRaw.filter((e) => {
    const t = new Date(e.publishedAt).getTime();
    return t >= ms(range.start) && t <= ms(range.end);
  });
  const wins: Record<string, number> = {};
  for (const e of eps) {
    const t = new Date(e.publishedAt).getTime();
    for (const w of e.winners ?? []) {
      const b = BENCH_RANGES[w];
      if (!members.includes(w) || !b || t < ms(b.start) || t > ms(b.end)) continue;
      wins[w] = (wins[w] ?? 0) + 1;
    }
  }
  const top = Object.entries(wins).sort(([, a], [, b]) => b - a)[0];
  return { episodes: eps.length, top: top ? { name: top[0], wins: top[1] } : null };
}

const ORDINAL = ["1ª formação", "2ª formação", "3ª formação"];
const eras = panelsData.panels.map((p, i) => ({
  ...p,
  ordinal: ORDINAL[i],
  stats: panelStats(p.slug, p.members),
}));

/* ── Dados do gráfico ── */
const eps = [...episodesRaw]
  .sort((a, b) => new Date(a.publishedAt).getTime() - new Date(b.publishedAt).getTime())
  .map((e) => ({
    t: new Date(e.publishedAt).getTime(),
    d: formatDate(e.publishedAt),
    title: e.title,
    f: e.publicFigure ?? null,
    w: e.winners ?? [],
  }));

/** start: primeira aparição (convidado); bench: vira titular; end: saída. */
const RANGES: Record<string, { start: string; bench: string; end?: string }> = {
  "José Roberto de Toledo": { start: "2018-01-01", bench: "2018-01-01", end: "2023-11-01" },
  "Thais Bilenky": { start: "2019-01-01", bench: "2021-01-01", end: "2023-11-01" },
  "Fernando de Barros e Silva": { start: "2018-01-01", bench: "2018-01-01" },
  "Malu Gaspar": { start: "2018-01-01", bench: "2018-01-01", end: "2021-02-01" },
  "Celso Rocha de Barros": { start: "2024-01-01", bench: "2024-01-01" },
  "Ana Clara Costa": { start: "2021-01-01", bench: "2024-01-01" },
};

const noon = (d: string) => new Date(`${d}T12:00:00Z`).getTime();

const people = PANELISTS.map((p) => ({
  name: p.name,
  short: p.short,
  color: p.color,
  img: `${base}/avatars/${p.slug}.png`,
  start: noon(RANGES[p.name].start),
  bench: noon(RANGES[p.name].bench),
  end: RANGES[p.name].end ? noon(RANGES[p.name].end!) : null,
}));

const all = PANELISTS.map((p) => p.name);
const modes = {
  all: { start: noon("2018-01-01"), end: noon("2099-01-01"), who: all },
  f1: { start: noon("2018-01-01"), end: noon("2021-02-28"), who: ["Fernando de Barros e Silva", "José Roberto de Toledo", "Malu Gaspar"] },
  f2: { start: noon("2021-03-01"), end: noon("2023-11-30"), who: ["Fernando de Barros e Silva", "José Roberto de Toledo", "Thais Bilenky"] },
  f3: { start: noon("2024-01-01"), end: noon("2099-01-01"), who: ["Fernando de Barros e Silva", "Celso Rocha de Barros", "Ana Clara Costa"] },
};

const bands = [
  { label: "1ª formação", short: "1ª", start: noon("2018-05-01"), end: noon("2021-01-31") },
  { label: "2ª formação", short: "2ª", start: noon("2021-02-01"), end: noon("2023-10-31") },
  { label: "3ª formação", short: "3ª", start: noon("2024-03-01"), end: null },
];

const payload = { eps, people, modes, bands };
---

<section class="sec corrida" id="corrida">
  <div class="wrap">
    <h2 class="sec-title">As três formações do Foro</h2>
    <p class="sec-lede">
      A bancada mudou duas vezes desde a estreia. Fernando é o único que atravessou as três formações.
    </p>

    <ol class="eras" id="fases">
      {eras.map((era) => (
        <li class="era">
          <p class="era-when">{era.ordinal}, {era.period.toLowerCase()}</p>
          <h3 class="era-title">{era.label}</h3>
          <div class="era-faces">
            {era.members.map((m) => (
              <figure>
                <img src={portrait(m)} alt={`Caricatura de ${m}`} loading="lazy" />
                <figcaption>{shortName(m)}</figcaption>
              </figure>
            ))}
          </div>
          <p class="era-stats">
            {era.stats.episodes} episódios.
            {era.stats.top && (
              <>
                {" "}Quem mais acertou foi <strong>{shortName(era.stats.top.name)}</strong>, {era.stats.top.wins} vezes.
              </>
            )}
          </p>
          <p class="note">{era.notes}</p>
        </li>
      ))}
    </ol>

    <h2 class="sec-title corrida-title">O ranking ao longo do tempo</h2>
    <p class="sec-lede">
      Acertos acumulados, episódio a episódio. Toledo abriu vantagem cedo e a manteve.
      Celso só chegou em 2024, mas já está mordendo o pódio, e a projeção é promissora.
    </p>

    <div class="seg corrida-filter" role="group" aria-label="Período do gráfico">
      <button type="button" data-mode="all" aria-pressed="true">História completa</button>
      <button type="button" data-mode="f1" aria-pressed="false">Só a 1ª formação</button>
      <button type="button" data-mode="f2" aria-pressed="false">Só a 2ª</button>
      <button type="button" data-mode="f3" aria-pressed="false">Só a 3ª</button>
    </div>

    <div class="chart-host">
      <div
        id="corrida-chart"
        class="chart"
        role="img"
        aria-label="Gráfico de linhas com os acertos acumulados de cada integrante da bancada ao longo do tempo"
        data-payload={JSON.stringify(payload)}
      ></div>
      <div class="chart-tip" id="corrida-tip" hidden></div>
    </div>

    <p class="note corrida-note">
      <span class="dash-key" aria-hidden="true"></span>
      O trecho tracejado é o período em que a pessoa aparecia como convidada, antes de virar titular.
      Nos filtros por formação, a contagem recomeça do zero.
    </p>
  </div>
</section>

<script>
  interface EpC { t: number; d: string; title: string; f: string | null; w: string[] }
  interface Person { name: string; short: string; color: string; img: string; start: number; bench: number; end: number | null }
  interface Mode { start: number; end: number; who: string[] }
  interface Band { label: string; short: string; start: number; end: number | null }
  interface Series { p: Person; scoreAt: (number | null)[]; guestD: string; mainD: string; lastIdx: number; last: number }

  const host = document.getElementById("corrida-chart");
  const tip = document.getElementById("corrida-tip");

  if (host && tip) {
    const data = JSON.parse(host.dataset.payload ?? "{}") as {
      eps: EpC[]; people: Person[]; modes: Record<string, Mode>; bands: Band[];
    };
    const NS = "http://www.w3.org/2000/svg";
    const MONTHS = ["jan.", "fev.", "mar.", "abr.", "maio", "jun.", "jul.", "ago.", "set.", "out.", "nov.", "dez."];
    const INK = "#2a1810", INK2 = "#6a5145", RULE = "#ddd0c0", MILK = "#ebe2d4", PAPER = "#f6f0e8";
    const UI = "'Alegreya Sans', 'Trebuchet MS', sans-serif";
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let mode = "all";
    let firstDraw = true;

    const el = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>, parent?: Element) => {
      const n = document.createElementNS(NS, tag);
      for (const k in attrs) n.setAttribute(k, String(attrs[k]));
      parent?.appendChild(n);
      return n;
    };
    const text = (str: string, attrs: Record<string, string | number>, parent: Element) => {
      const n = el("text", { "font-family": UI, "font-size": 14, fill: INK2, ...attrs }, parent);
      n.textContent = str;
      return n;
    };
    const yearStart = (y: number) => Date.UTC(y, 0, 1);
    const monthYear = (t: number) => {
      const d = new Date(t);
      return `${MONTHS[d.getUTCMonth()]} de ${d.getUTCFullYear()}`;
    };

    function draw() {
      const def = data.modes[mode];
      const W = host!.clientWidth;
      const mobile = W < 640;
      const H = mobile ? 400 : 520;
      const m = { l: 30, r: mobile ? 62 : 132, t: 34, b: 30 };
      const eps = data.eps.filter((e) => e.t >= def.start && e.t <= def.end);
      const people = data.people.filter((p) => def.who.includes(p.name));
      const lastT = eps[eps.length - 1].t;

      /* ── séries ── */
      const raw = people.map((p) => {
        let score = 0;
        let lastIdx = -1;
        const scoreAt: (number | null)[] = eps.map((e, i) => {
          if (e.t < p.start || (p.end !== null && e.t > p.end)) return null;
          if (e.w.includes(p.name)) score++;
          lastIdx = i;
          return score;
        });
        return { p, scoreAt, lastIdx, last: score };
      }).filter((s) => s.lastIdx >= 0);

      /* ── projeção do Celso (só na história completa) ── */
      let forecast: { t: number; y: number; fromT: number; fromY: number } | null = null;
      const celso = raw.find((s) => s.p.name === "Celso Rocha de Barros");
      const toledo = raw.find((s) => s.p.name === "José Roberto de Toledo");
      if (mode === "all" && celso && toledo && celso.last > 0 && celso.last < toledo.last) {
        const first = eps[celso.scoreAt.findIndex((v) => v !== null)].t;
        const rate = celso.last / (lastT - first);
        forecast = { t: first + toledo.last / rate, y: toledo.last, fromT: lastT, fromY: celso.last };
      }

      /* ── escalas ── */
      const y0 = new Date(eps[0].t).getUTCFullYear();
      const tMin = mode === "all" || mode === "f1" ? yearStart(y0) : eps[0].t - 20 * 864e5;
      const tMax = forecast ? forecast.t + 20 * 864e5 : lastT + 10 * 864e5;
      const maxScore = Math.max(...raw.map((s) => s.last), forecast?.y ?? 0);
      const step = maxScore > 45 ? 20 : 10;
      const yMax = Math.max(step, Math.ceil((maxScore + (forecast ? 8 : 1)) / 5) * 5);
      const x = (t: number) => m.l + ((t - tMin) / (tMax - tMin)) * (W - m.l - m.r);
      const y = (v: number) => H - m.b - (v / yMax) * (H - m.t - m.b);

      const series: Series[] = raw.map((s) => {
        let guestD = "", mainD = "";
        let prev = 0;
        let started = false;
        let crossed = false;
        const add = (isGuest: boolean, cmd: string) => { if (isGuest) guestD += cmd; else mainD += cmd; };
        s.scoreAt.forEach((v, i) => {
          if (v === null) return;
          const t = eps[i].t;
          let guest = t < s.p.bench;
          if (!started) {
            add(guest, `M${x(t).toFixed(1)},${y(0).toFixed(1)}`);
            started = true;
            crossed = !guest;
          }
          if (!guest && !crossed) {
            // passa de convidado a titular: o tracejado vai até aqui e o traço cheio assume
            guestD += `H${x(t).toFixed(1)}`;
            mainD += `M${x(t).toFixed(1)},${y(prev).toFixed(1)}`;
            crossed = true;
          }
          if (v !== prev) add(guest, `H${x(t).toFixed(1)}V${y(v).toFixed(1)}`);
          else if (i === s.lastIdx) add(guest, `H${x(t).toFixed(1)}`);
          prev = v;
        });
        return { ...s, guestD, mainD };
      });

      /* ── desenho ── */
      host!.replaceChildren();
      const svg = el("svg", { width: W, height: H, viewBox: `0 0 ${W} ${H}` }, host!);
      svg.style.display = "block";
      svg.style.overflow = "visible";

      // faixas das formações
      if (mode === "all") {
        data.bands.forEach((b, i) => {
          const x1 = x(b.start), x2 = x(b.end ?? lastT);
          if (i === 1) el("rect", { x: x1, y: m.t - 24, width: x2 - x1, height: H - m.b - m.t + 24, fill: MILK }, svg);
          text(mobile ? b.short : b.label, { x: x1 + 8, y: m.t - 8, "font-weight": 700, fill: INK, "font-size": 13 }, svg);
        });
      }

      // grade e eixo y
      for (let v = 0; v <= yMax; v += step) {
        el("line", { x1: m.l, x2: W - m.r, y1: y(v), y2: y(v), stroke: v === 0 ? INK : RULE, "stroke-width": v === 0 ? 1.5 : 1 }, svg);
        text(String(v), { x: m.l - 8, y: y(v) + 4.5, "text-anchor": "end" }, svg);
      }

      // eixo x: um rótulo por ano
      const yLast = new Date(tMax).getUTCFullYear();
      for (let yr = new Date(tMin).getUTCFullYear(); yr <= yLast; yr++) {
        const t = yearStart(yr);
        if (t < tMin - 1 || t > tMax) continue;
        el("line", { x1: x(t), x2: x(t), y1: H - m.b, y2: H - m.b + 5, stroke: INK }, svg);
        const span = x(yearStart(yr + 1)) - x(t);
        text(span < 46 ? `’${String(yr).slice(2)}` : String(yr), { x: x(t) + 4, y: H - m.b + 19 }, svg);
      }

      // projeção
      if (forecast) {
        const c = celso!.p.color;
        el("line", {
          x1: x(forecast.fromT), y1: y(forecast.fromY), x2: x(forecast.t), y2: y(forecast.y),
          stroke: c, "stroke-width": 2, "stroke-dasharray": "1 6", "stroke-linecap": "round",
        }, svg);
        el("circle", { cx: x(forecast.t), cy: y(forecast.y), r: 5, fill: PAPER, stroke: c, "stroke-width": 2 }, svg);
        const lines = mobile
          ? ["Nesse ritmo, Celso", `chega aos ${forecast.y} de`, `Toledo em ${monthYear(forecast.t)}`]
          : ["Nesse ritmo, Celso chega aos", `${forecast.y} de Toledo em ${monthYear(forecast.t)}`];
        lines.forEach((ln, i) => {
          text(ln, {
            x: x(forecast!.t) + (mobile ? 54 : 8), y: y(forecast!.y) - 14 - (lines.length - 1 - i) * 17,
            "text-anchor": "end", fill: INK, "font-style": "italic", "font-size": mobile ? 13 : 15,
            stroke: PAPER, "stroke-width": 4, "paint-order": "stroke", "stroke-linejoin": "round",
          }, svg);
        });
      }

      // linhas
      const lineLayer = el("g", { fill: "none", "stroke-linejoin": "round", "stroke-linecap": "round" }, svg);
      series.forEach((s) => {
        if (s.guestD) el("path", { d: s.guestD, stroke: s.p.color, "stroke-width": 2, "stroke-dasharray": "5 5", opacity: 0.75 }, lineLayer);
        if (s.mainD) {
          el("path", { d: s.mainD, stroke: PAPER, "stroke-width": 5 }, lineLayer);
          const path = el("path", { d: s.mainD, stroke: s.p.color, "stroke-width": 2.5 }, lineLayer);
          if (firstDraw && !reduce) {
            const len = path.getTotalLength();
            path.style.strokeDasharray = `${len}`;
            path.style.strokeDashoffset = `${len}`;
            path.getBoundingClientRect();
            path.style.transition = "stroke-dashoffset 1.4s ease-out";
            path.style.strokeDashoffset = "0";
            setTimeout(() => { path.style.strokeDasharray = ""; path.style.transition = ""; }, 1500);
          }
        }
      });

      // anotações: ultrapassagens (só no desktop, onde há espaço)
      if (mode === "all" && W >= 900) {
        const malu = series.find((s) => s.p.name === "Malu Gaspar");
        const pass = (who: string, dx: number, dy: number) => {
          const s = series.find((q) => q.p.name === who);
          if (!s || !malu) return;
          const idx = s.scoreAt.findIndex((v) => v !== null && v > malu.last);
          if (idx < 0) return;
          const px = x(eps[idx].t), py = y(s.scoreAt[idx]!);
          el("line", { x1: px, y1: py - 6, x2: px + dx + 4, y2: py + dy + 6, stroke: INK2, "stroke-width": 1 }, svg);
          el("circle", { cx: px, cy: py, r: 4.5, fill: PAPER, stroke: INK, "stroke-width": 1.5 }, svg);
          [`${s.p.short} passa Malu`, `em ${monthYear(eps[idx].t)}`].forEach((ln, i) => {
            text(ln, {
              x: px + dx, y: py + dy - 17 + i * 17, "text-anchor": "end", fill: INK, "font-style": "italic", "font-size": 15,
              stroke: PAPER, "stroke-width": 4, "paint-order": "stroke", "stroke-linejoin": "round",
            }, svg);
          });
        };
        pass("José Roberto de Toledo", -18, -44);
        pass("Fernando de Barros e Silva", -18, -52);
      }

      // rótulos no fim de cada linha (rosto + total), sem encavalar
      const face = mobile ? 28 : 36;
      // quando há projeção, os rótulos de quem segue na bancada vão para a margem,
      // para não ficarem no caminho da linha pontilhada
      const labels = series
        .map((s) => {
          const px = x(eps[s.lastIdx].t);
          const parked = !!forecast && s.lastIdx === eps.length - 1;
          return { s, px, lx: parked ? x(tMax) + 2 : px, ly: y(s.last), parked };
        })
        .sort((a, b) => a.ly - b.ly);
      const minGap = face + 2;
      for (let i = 1; i < labels.length; i++) {
        const a = labels[i - 1], b = labels[i];
        if (Math.abs(a.lx - b.lx) < 120 && b.ly - a.ly < minGap) b.ly = a.ly + minGap;
      }
      const overflow = Math.max(0, ...labels.map((l) => l.ly + face / 2 - (H - m.b)));
      if (overflow > 0) labels.forEach((l) => { if (Math.abs(l.lx - labels[labels.length - 1].lx) < 120) l.ly -= overflow; });

      const labelLayer = el("g", {}, svg);
      labels.forEach(({ s, px, lx, ly, parked }) => {
        if (parked) {
          el("path", {
            d: `M${px + 6},${y(s.last)}L${lx - 6},${ly}H${lx + 4}`,
            fill: "none", stroke: s.p.color, "stroke-width": 1, opacity: 0.55,
          }, labelLayer);
        }
        el("circle", { cx: px, cy: y(s.last), r: 4, fill: s.p.color, stroke: PAPER, "stroke-width": 1.5 }, labelLayer);
        el("image", { href: s.p.img, x: lx + 6, y: ly - face / 2, width: face, height: face, preserveAspectRatio: "xMidYMid meet" }, labelLayer);
        const t = text("", {
          x: lx + face + 10, y: ly + 5, fill: INK, "font-size": mobile ? 15 : 16,
          stroke: PAPER, "stroke-width": 4, "paint-order": "stroke", "stroke-linejoin": "round",
        }, labelLayer);
        const num = el("tspan", { "font-weight": 800 }, t);
        num.textContent = String(s.last);
        if (!mobile) {
          const nm = el("tspan", { dx: 5 }, t);
          nm.textContent = s.p.short;
        }
      });

      /* ── interação ── */
      const cross = el("g", { visibility: "hidden" }, svg);
      const rule = el("line", { y1: m.t - 24, y2: H - m.b, stroke: INK, "stroke-width": 1 }, cross);
      const dots = series.map((s) => el("circle", { r: 5, fill: s.p.color, stroke: PAPER, "stroke-width": 2 }, cross));
      const hit = el("rect", { x: m.l, y: 0, width: W - m.l - m.r, height: H, fill: "transparent" }, svg);
      hit.style.touchAction = "pan-y";

      const move = (ev: PointerEvent) => {
        const box = svg.getBoundingClientRect();
        const px = ev.clientX - box.left;
        let best = 0, bestD = Infinity;
        eps.forEach((e, i) => {
          const d = Math.abs(x(e.t) - px);
          if (d < bestD) { bestD = d; best = i; }
        });
        const ep = eps[best];
        const ex = x(ep.t);
        cross.setAttribute("visibility", "visible");
        rule.setAttribute("x1", String(ex));
        rule.setAttribute("x2", String(ex));
        const rows: { s: Series; v: number }[] = [];
        series.forEach((s, i) => {
          const v = s.scoreAt[best];
          dots[i].setAttribute("visibility", v === null ? "hidden" : "inherit");
          if (v === null) return;
          dots[i].setAttribute("cx", String(ex));
          dots[i].setAttribute("cy", String(y(v)));
          rows.push({ s, v });
        });
        rows.sort((a, b) => b.v - a.v);

        tip!.replaceChildren();
        const head = document.createElement("p");
        head.className = "chart-tip-date";
        head.textContent = ep.d;
        const ttl = document.createElement("p");
        ttl.className = "chart-tip-title";
        ttl.textContent = ep.title;
        tip!.append(head, ttl);
        if (ep.f) {
          const fg = document.createElement("p");
          fg.className = "chart-tip-fig";
          fg.textContent = `A voz era de ${ep.f}`;
          tip!.append(fg);
        }
        const list = document.createElement("ul");
        rows.forEach(({ s, v }) => {
          const li = document.createElement("li");
          const sw = document.createElement("i");
          sw.style.background = s.p.color;
          const nm = document.createElement("span");
          nm.textContent = s.p.short;
          const val = document.createElement("b");
          val.textContent = String(v);
          li.append(sw, nm, val);
          if (ep.w.includes(s.p.name)) {
            const plus = document.createElement("em");
            plus.textContent = "acertou";
            li.append(plus);
          }
          list.append(li);
        });
        tip!.append(list);
        tip!.hidden = false;
        const tw = tip!.offsetWidth;
        const left = ex + 14 + tw > W ? ex - 14 - tw : ex + 14;
        tip!.style.left = `${Math.max(0, left)}px`;
        tip!.style.top = `${m.t}px`;
      };
      const leave = () => {
        cross.setAttribute("visibility", "hidden");
        tip!.hidden = true;
      };
      hit.addEventListener("pointermove", move);
      hit.addEventListener("pointerdown", move);
      hit.addEventListener("pointerleave", leave);

      firstDraw = false;
    }

    // desenha quando o gráfico entra na tela, para a animação inicial ser vista
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      draw();
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { start(); io.disconnect(); }
      }, { threshold: 0.15 });
      io.observe(host);
    } else {
      start();
    }

    let lastW = host.clientWidth;
    window.addEventListener("resize", () => {
      if (!started || host.clientWidth === lastW) return;
      lastW = host.clientWidth;
      draw();
    });
    document.fonts?.ready.then(() => { if (started) draw(); });

    document.querySelectorAll<HTMLButtonElement>(".corrida-filter button").forEach((btn) => {
      btn.addEventListener("click", () => {
        mode = btn.dataset.mode ?? "all";
        document.querySelectorAll(".corrida-filter button").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        tip.hidden = true;
        started = true;
        draw();
      });
    });
  }
</script>

