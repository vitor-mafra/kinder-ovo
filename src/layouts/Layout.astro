---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Ranking e estatísticas do Momento Kinder Ovo no Foro de Teresina.",
  image = "/og-image.jpg",
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : "https://kinderovo.com";
const socialImageURL = new URL(image, siteUrl).href;
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f0e8" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={socialImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <main id="topo">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-grid">
        <div class="footer-about">
          <p class="footer-name">Momento Kinder Ovo</p>
          <p>Feito por <a href="https://vitormafra.com">Vitor Mafra</a>, ouvinte do Foro.</p>
          <p class="footer-data">
            Dados abertos.
            <a href={`${base}/dados/`}>Baixe a base completa</a>
          </p>
          <p class="footer-license">
            <span class="copyleft" aria-hidden="true">©</span> Copyleft 2026,
            <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.pt" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>
          </p>
          <p class="footer-top"><a href="#topo">Voltar ao início</a></p>
        </div>

        <div class="footer-legal" id="aviso-legal">
          <div>
            <h2>Projeto de fã, sem vínculo oficial</h2>
            <p>
              Este site é um projeto pessoal e independente, criado por um ouvinte do
              <em>Foro de Teresina</em> por pura admiração ao programa. Não tem qualquer
              relação, vínculo ou aprovação da revista piauí, dos jornalistas que
              compõem o podcast, de suas produtoras ou de quaisquer entidades a eles
              ligadas. Nenhum conteúdo aqui publicado representa posição oficial do
              programa ou da revista.
            </p>
          </div>
          <div>
            <h2>Uso da marca Kinder Ovo®</h2>
            <p>
              “Kinder Ovo” é uma marca registrada da Ferrero S.p.A. O uso do nome
              neste site é meramente referencial, para identificar o quadro homônimo
              do podcast, e não implica qualquer relação comercial, patrocínio ou
              endosso da empresa. Este é um projeto sem fins lucrativos, não comercial
              e puramente recreativo.
            </p>
          </div>
        </div>
      </div>
    </footer>

    <style>
      .footer {
        margin-top: var(--gap-section);
        border-top: 2px solid var(--ink);
        color: var(--ink);
        padding: clamp(40px, 6vw, 64px) 0 clamp(40px, 6vw, 64px);
        font-family: var(--font-ui);
        font-size: 1rem;
        line-height: 1.5;
      }

      .footer-grid {
        display: grid;
        gap: 36px;
        justify-items: center;
        text-align: center;
      }

      .footer-name {
        font-family: var(--font-display);
        font-size: 2rem;
        line-height: 1;
        margin-bottom: 10px;
      }

      .footer-about p { max-width: 36ch; margin-inline: auto; }

      .footer-data {
        font-weight: 700;
        margin: 22px auto 24px !important;
      }

      .footer-data a {
        display: block;
        width: fit-content;
        margin: 8px auto 0;
        background: var(--yolk);
        font-size: 1.125rem;
        padding: 7px 16px 8px;
        border-radius: 6px;
        text-decoration: none;
      }

      .footer-license,
      .footer-top {
        font-size: 0.9375rem;
        color: var(--ink-2);
      }

      .footer-about .footer-top { margin-top: 4px; }

      .footer-data a:hover { background: var(--yolk-deep); }

      .copyleft {
        display: inline-block;
        transform: scaleX(-1);
      }

      .footer-legal {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px 32px;
        font-size: 0.875rem;
        line-height: 1.5;
        color: var(--ink-2);
        max-width: 840px;
        text-align: left;
        padding-top: 28px;
        border-top: 1px solid var(--rule);
      }

      .footer-legal h2 {
        font-family: var(--font-ui);
        font-size: 0.875rem;
        font-weight: 700;
        line-height: 1.3;
        color: var(--ink);
        margin-bottom: 6px;
      }

      @media (max-width: 560px) {
        .footer-legal { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
